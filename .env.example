# Copy to .env for docker-compose.prod.yml. Never commit .env.

# Your public domain. Caddy gets a TLS certificate for it automatically.
PHX_HOST=chat.example.com

# Generate with: openssl rand -base64 48
SECRET_KEY_BASE=

# Use letters and digits only, because this goes into the database URL.
POSTGRES_PASSWORD=

# Database connections per node.
POOL_SIZE=20

# Each device's ciphertext is cleared when it receives a message. After all have it:
# keep_metadata keeps the message row, delete_row removes it (read receipts then stop).
MESSAGE_RETENTION=keep_metadata

# Enables push through Firebase Cloud Messaging. Leave empty to only log pushes.
# Generate from the service account file with: base64 -i service-account.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=
